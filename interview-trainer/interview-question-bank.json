  "questions": [
    {
      "id": "A-01",
      "category": "A",
      "text": "今回、転職を考えたきっかけを教えてください。",
      "source": "頻出"
    },
    {
      "id": "A-02",
      "category": "A",
      "text": "現職の何が変われば、転職せずに済みましたか。",
      "source": "深掘り"
    },
    {
      "id": "A-03",
      "category": "A",
      "text": "会社を選ぶうえで、いちばん譲れない軸は何ですか。",
      "source": "頻出"
    },
    {
      "id": "A-04",
      "category": "A",
      "text": "その軸は、いつごろ、何をきっかけに固まりましたか。",
      "source": "深掘り"
    },
    {
      "id": "A-05",
      "category": "A",
      "text": "今の会社では、その軸は本当に満たせないのですか。",
      "source": "深掘り"
    },
    {
      "id": "A-06",
      "category": "A",
      "text": "転職先を選ぶ基準を、優先順位をつけて3つ挙げてください。",
      "source": "頻出"
    },
    {
      "id": "A-07",
      "category": "A",
      "text": "現職に不満があるとのことですが、ご自身に改善できる余地はありませんでしたか。",
      "source": "圧迫"
    },
    {
      "id": "A-08",
      "category": "A",
      "text": "転職活動はいつから始めましたか。他にどんな会社を受けていますか。",
      "source": "一次"
    },
    {
      "id": "A-09",
      "category": "A",
      "text": "前回の転職も同じ理由でしたか。",
      "source": "深掘り"
    },
    {
      "id": "A-10",
      "category": "A",
      "text": "もし現職から強い引き止めがあったら、どうしますか。",
      "source": "最終"
    },
    {
      "id": "A-11",
      "category": "A",
      "text": "転職は今でなければいけない理由は何ですか。",
      "source": "深掘り"
    },
    {
      "id": "A-12",
      "category": "A",
      "text": "転職して、何が手に入れば成功だと言えますか。",
      "source": "深掘り"
    },
    {
      "id": "B-01",
      "category": "B",
      "text": "これまでのキャリアを1分で説明してください。",
      "source": "頻出"
    },
    {
      "id": "B-02",
      "category": "B",
      "text": "前々職から前職への転職は、どういう判断でしたか。",
      "source": "深掘り"
    },
    {
      "id": "B-03",
      "category": "B",
      "text": "職種が変わっていますが、その間で一貫しているものは何ですか。",
      "source": "深掘り"
    },
    {
      "id": "B-04",
      "category": "B",
      "text": "キャリアの中で、いちばん大きな転機はどこですか。",
      "source": "頻出"
    },
    {
      "id": "B-05",
      "category": "B",
      "text": "これまでの経験は、応募いただいた職種にどうつながりますか。",
      "source": "頻出"
    },
    {
      "id": "B-06",
      "category": "B",
      "text": "選ばなかった道について、いま振り返ってどう思いますか。",
      "source": "深掘り"
    },
    {
      "id": "B-07",
      "category": "B",
      "text": "ご経歴を拝見すると軸がぶれているように見えますが、いかがですか。",
      "source": "圧迫"
    },
    {
      "id": "B-08",
      "category": "B",
      "text": "これまでのそれぞれの会社で、何を得ましたか。",
      "source": "二次"
    },
    {
      "id": "B-09",
      "category": "B",
      "text": "業界を変えた理由を教えてください。",
      "source": "頻出"
    },
    {
      "id": "B-10",
      "category": "B",
      "text": "これまでで、自分の意思で選び取ったと言える経験はどれですか。",
      "source": "深掘り"
    },
    {
      "id": "C-01",
      "category": "C",
      "text": "いちばん成果が出た仕事について教えてください。",
      "source": "頻出"
    },
    {
      "id": "C-02",
      "category": "C",
      "text": "その成果のうち、あなた自身の貢献はどこですか。",
      "source": "深掘り"
    },
    {
      "id": "C-03",
      "category": "C",
      "text": "その成果は、環境が変わっても再現できますか。",
      "source": "深掘り"
    },
    {
      "id": "C-04",
      "category": "C",
      "text": "再現するために必要な条件は何ですか。",
      "source": "深掘り"
    },
    {
      "id": "C-05",
      "category": "C",
      "text": "うまくいかなかった仕事について教えてください。",
      "source": "頻出"
    },
    {
      "id": "C-06",
      "category": "C",
      "text": "その失敗から、具体的に何を変えましたか。",
      "source": "深掘り"
    },
    {
      "id": "C-07",
      "category": "C",
      "text": "数字で語れる実績を1つ挙げてください。",
      "source": "頻出"
    },
    {
      "id": "C-08",
      "category": "C",
      "text": "その数字は、何と比べて良いのですか。",
      "source": "圧迫"
    },
    {
      "id": "C-09",
      "category": "C",
      "text": "あなたがいなくても、その成果は出ていたのではないですか。",
      "source": "圧迫"
    },
    {
      "id": "C-10",
      "category": "C",
      "text": "直近1年で、いちばん時間を使った仕事は何ですか。",
      "source": "二次"
    },
    {
      "id": "C-11",
      "category": "C",
      "text": "成果を出すために、あなたが独自に工夫したことは何ですか。",
      "source": "深掘り"
    },
    {
      "id": "C-12",
      "category": "C",
      "text": "その進め方は、当社でも通用すると思いますか。",
      "source": "深掘り"
    },
    {
      "id": "D-01",
      "category": "D",
      "text": "なぜ当社なのか、他社ではない理由を教えてください。",
      "source": "頻出"
    },
    {
      "id": "D-02",
      "category": "D",
      "text": "当社の事業について、理解していることを聞かせてください。",
      "source": "頻出"
    },
    {
      "id": "D-03",
      "category": "D",
      "text": "当社の課題は何だと思いますか。",
      "source": "深掘り"
    },
    {
      "id": "D-04",
      "category": "D",
      "text": "当社の競合をどう見ていますか。",
      "source": "深掘り"
    },
    {
      "id": "D-05",
      "category": "D",
      "text": "当社のどの事業に関わりたいですか。",
      "source": "二次"
    },
    {
      "id": "D-06",
      "category": "D",
      "text": "当社を知ったきっかけは何ですか。",
      "source": "一次"
    },
    {
      "id": "D-07",
      "category": "D",
      "text": "入社したら、最初の3か月で何をしますか。",
      "source": "深掘り"
    },
    {
      "id": "D-08",
      "category": "D",
      "text": "あなたを採用すると、当社にどんな良いことがありますか。",
      "source": "頻出"
    },
    {
      "id": "D-09",
      "category": "D",
      "text": "当社の弱いところはどこだと思いますか。",
      "source": "圧迫"
    },
    {
      "id": "D-10",
      "category": "D",
      "text": "当社の社風に合うと思う理由を教えてください。",
      "source": "二次"
    },
    {
      "id": "D-11",
      "category": "D",
      "text": "当社のサービスを使ったことはありますか。感想を聞かせてください。",
      "source": "一次"
    },
    {
      "id": "D-12",
      "category": "D",
      "text": "内定が出たら、迷わず入社されますか。",
      "source": "最終"
    },
    {
      "id": "E-01",
      "category": "E",
      "text": "ご自身の強みを、仕事の場面に即して教えてください。",
      "source": "頻出"
    },
    {
      "id": "E-02",
      "category": "E",
      "text": "その強みが最も発揮された場面はどこですか。",
      "source": "深掘り"
    },
    {
      "id": "E-03",
      "category": "E",
      "text": "弱みと、それにどう対処しているかを教えてください。",
      "source": "頻出"
    },
    {
      "id": "E-04",
      "category": "E",
      "text": "周りからはどんな人だと言われますか。",
      "source": "一次"
    },
    {
      "id": "E-05",
      "category": "E",
      "text": "前職の上司は、あなたをどう評価していましたか。",
      "source": "二次"
    },
    {
      "id": "E-06",
      "category": "E",
      "text": "苦手なタイプの仕事は何ですか。",
      "source": "一次"
    },
    {
      "id": "E-07",
      "category": "E",
      "text": "その強みは、当社ではどう活きますか。",
      "source": "深掘り"
    },
    {
      "id": "E-08",
      "category": "E",
      "text": "その弱みで、実際に失敗したことはありますか。",
      "source": "深掘り"
    },
    {
      "id": "F-01",
      "category": "F",
      "text": "チームで意見が割れたとき、どう動きましたか。",
      "source": "頻出"
    },
    {
      "id": "F-02",
      "category": "F",
      "text": "苦手な人と仕事をしたときの話を聞かせてください。",
      "source": "二次"
    },
    {
      "id": "F-03",
      "category": "F",
      "text": "他部署を巻き込んで進めた経験を教えてください。",
      "source": "頻出"
    },
    {
      "id": "F-04",
      "category": "F",
      "text": "反対されている提案を通した経験はありますか。",
      "source": "深掘り"
    },
    {
      "id": "F-05",
      "category": "F",
      "text": "あなたはチームでどんな役割になることが多いですか。",
      "source": "一次"
    },
    {
      "id": "F-06",
      "category": "F",
      "text": "後輩や部下の育成で工夫したことはありますか。",
      "source": "二次"
    },
    {
      "id": "F-07",
      "category": "F",
      "text": "上司と意見が合わないとき、どうしますか。",
      "source": "頻出"
    },
    {
      "id": "F-08",
      "category": "F",
      "text": "一人で進めるのとチームで進めるの、どちらが得意ですか。",
      "source": "一次"
    },
    {
      "id": "G-01",
      "category": "G",
      "text": "担当された数字の規模感を教えてください。",
      "source": "頻出"
    },
    {
      "id": "G-02",
      "category": "G",
      "text": "予算や目標はどう決めていましたか。",
      "source": "二次"
    },
    {
      "id": "G-03",
      "category": "G",
      "text": "目標未達のとき、どう立て直しましたか。",
      "source": "深掘り"
    },
    {
      "id": "G-04",
      "category": "G",
      "text": "何人のチームを見ていましたか。",
      "source": "一次"
    },
    {
      "id": "G-05",
      "category": "G",
      "text": "メンバーの評価はどうつけていましたか。",
      "source": "二次"
    },
    {
      "id": "G-06",
      "category": "G",
      "text": "コストを下げた経験はありますか。",
      "source": "二次"
    },
    {
      "id": "G-07",
      "category": "G",
      "text": "進捗をどう管理していましたか。",
      "source": "二次"
    },
    {
      "id": "G-08",
      "category": "G",
      "text": "マネジメントで、いちばん難しかったことは何ですか。",
      "source": "深掘り"
    },
    {
      "id": "H-01",
      "category": "H",
      "text": "在職期間が短い理由を教えてください。",
      "source": "頻出"
    },
    {
      "id": "H-02",
      "category": "H",
      "text": "ブランク期間は何をされていましたか。",
      "source": "頻出"
    },
    {
      "id": "H-03",
      "category": "H",
      "text": "転職回数が多いように見えますが、いかがですか。",
      "source": "圧迫"
    },
    {
      "id": "H-04",
      "category": "H",
      "text": "若い上司の下で働くことに、抵抗はありませんか。",
      "source": "圧迫"
    },
    {
      "id": "H-05",
      "category": "H",
      "text": "未経験の職種ですが、キャッチアップできますか。",
      "source": "深掘り"
    },
    {
      "id": "H-06",
      "category": "H",
      "text": "前職を退職された経緯を、もう少し詳しく教えてください。",
      "source": "深掘り"
    },
    {
      "id": "H-07",
      "category": "H",
      "text": "体調やご家庭の事情で、働き方に制約はありますか。",
      "source": "条件確認"
    },
    {
      "id": "H-08",
      "category": "H",
      "text": "またすぐ辞めてしまうのではないかと心配なのですが。",
      "source": "圧迫"
    },
    {
      "id": "H-09",
      "category": "H",
      "text": "年収が下がる可能性がありますが、大丈夫ですか。",
      "source": "圧迫"
    },
    {
      "id": "H-10",
      "category": "H",
      "text": "前職では評価されていなかった、ということですか。",
      "source": "圧迫"
    },
    {
      "id": "H-11",
      "category": "H",
      "text": "空白期間中、収入はどうされていましたか。",
      "source": "深掘り"
    },
    {
      "id": "H-12",
      "category": "H",
      "text": "ご経歴の中で、ご自身でも弱いと感じる部分はどこですか。",
      "source": "深掘り"
    },
    {
      "id": "I-01",
      "category": "I",
      "text": "希望年収と、その根拠を教えてください。",
      "source": "頻出"
    },
    {
      "id": "I-02",
      "category": "I",
      "text": "現在の年収の内訳を教えてください。",
      "source": "条件確認"
    },
    {
      "id": "I-03",
      "category": "I",
      "text": "提示額が希望に届かない場合、どうされますか。",
      "source": "最終"
    },
    {
      "id": "I-04",
      "category": "I",
      "text": "転勤は可能ですか。",
      "source": "条件確認"
    },
    {
      "id": "I-05",
      "category": "I",
      "text": "残業や休日出勤については、どうお考えですか。",
      "source": "条件確認"
    },
    {
      "id": "I-06",
      "category": "I",
      "text": "入社可能日はいつですか。",
      "source": "条件確認"
    },
    {
      "id": "I-07",
      "category": "I",
      "text": "他社の選考状況を教えてください。",
      "source": "最終"
    },
    {
      "id": "J-01",
      "category": "J",
      "text": "3年後、どうなっていたいですか。",
      "source": "頻出"
    },
    {
      "id": "J-02",
      "category": "J",
      "text": "5年後、10年後のキャリアをどう考えていますか。",
      "source": "二次"
    },
    {
      "id": "J-03",
      "category": "J",
      "text": "将来、マネジメントと専門職のどちらに進みたいですか。",
      "source": "二次"
    },
    {
      "id": "J-04",
      "category": "J",
      "text": "当社でやりたいことを教えてください。",
      "source": "頻出"
    },
    {
      "id": "J-05",
      "category": "J",
      "text": "その目標のために、いま何をしていますか。",
      "source": "深掘り"
    },
    {
      "id": "J-06",
      "category": "J",
      "text": "独立や起業の予定はありますか。",
      "source": "最終"
    },
    {
      "id": "J-07",
      "category": "J",
      "text": "学び続けるために、習慣にしていることはありますか。",
      "source": "二次"
    },
    {
      "id": "K-01",
      "category": "K",
      "text": "最後に、何か質問はありますか。",
      "source": "頻出"
    },
    {
      "id": "K-02",
      "category": "K",
      "text": "入社までに準備しておくとよいことはありますか。",
      "source": "定番"
    },
    {
      "id": "K-03",
      "category": "K",
      "text": "このポジションで活躍している方に共通することは何ですか。",
      "source": "定番"
    },
    {
      "id": "K-04",
      "category": "K",
      "text": "配属予定のチーム構成を教えていただけますか。",
      "source": "定番"
    },
    {
      "id": "K-05",
      "category": "K",
      "text": "入社後、最初の半年で期待される成果は何ですか。",
      "source": "定番"
    },
    {
      "id": "K-06",
      "category": "K",
      "text": "評価はどのような基準で行われますか。",
      "source": "定番"
    },
    {
      "id": "K-07",
      "category": "K",
      "text": "御社が今いちばん力を入れている領域はどこですか。",
      "source": "定番"
    },
    {
      "id": "K-08",
      "category": "K",
      "text": "この職種で、難しさを感じるのはどんな場面ですか。",
      "source": "定番"
    },
    {
      "id": "K-09",
      "category": "K",
      "text": "面接官ご自身が、この会社を選んだ理由を伺えますか。",
      "source": "踏み込み"
    },
    {
      "id": "K-10",
      "category": "K",
      "text": "私の経歴で、懸念があれば教えていただけますか。",
      "source": "踏み込み"
    },
    {
      "id": "K-11",
      "category": "K",
      "text": "今後の選考の流れを教えてください。",
      "source": "定番"
    },
    {
      "id": "K-12",
      "category": "K",
      "text": "チームの働き方（リモート・出社）について教えてください。",
      "source": "定番"
    }
  ]
}
